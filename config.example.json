{
  "app": {
    "closeBehavior": "tray",
    "startAtLogin": false
  },
  "router": {
    "host": "127.0.0.1",
    "port": 4000,
    "apiKey": "replace-with-a-local-router-token",
    "requestTimeoutMs": 30000,
    "maxBodyBytes": 52428800,
    "fallbackStatusCodes": [408, 409, 425, 429, 500, 502, 503, 504],
    "logFile": "logs/router.log"
  },
  "vendors": [
    {
      "name": "primary-vendor",
      "baseUrl": "https://api.primary.example/v1",
      "models": [
        {
          "id": "model-id",
          "enabled": true,
          "pricing": {
            "mode": "custom",
            "currency": "USD",
            "inputPerMillion": 1,
            "cachedInputPerMillion": 0.1,
            "outputPerMillion": 4
          }
        },
        {
          "id": "gpt-5-mini",
          "enabled": true
        }
      ],
      "authentication": "api-key",
      "apiKeyHeader": "authorization",
      "apiKey": "replace-with-primary-vendor-key",
      "requestFormat": "chat-completions",
      "enabled": false
    },
    {
      "name": "local-vllm-vendor",
      "baseUrl": "http://127.0.0.1:8000/v1",
      "models": [
        {
          "id": "model-id",
          "enabled": true,
          "enableThinking": true
        }
      ],
      "authentication": "none",
      "requestFormat": "chat-completions",
      "enabled": false
    },
    {
      "name": "fallback-vendor",
      "baseUrl": "https://api.fallback.example/v1",
      "models": [
        {
          "id": "model-id",
          "enabled": true
        },
        {
          "id": "coder-model",
          "enabled": true
        }
      ],
      "authentication": "api-key",
      "apiKeyHeader": "authorization",
      "apiKey": "replace-with-fallback-vendor-key",
      "requestFormat": "responses",
      "enabled": false
    },
    {
      "name": "local-embeddings-vendor",
      "baseUrl": "http://127.0.0.1:8002/v1",
      "models": [
        {
          "id": "embed-model",
          "enabled": true
        }
      ],
      "authentication": "none",
      "requestFormat": "embeddings",
      "embeddingsPath": "/embeddings",
      "enabled": false
    },
    {
      "name": "custom-vendor",
      "baseUrl": "http://127.0.0.1:8003/v1/embeddings",
      "models": [
        {
          "id": "custom-model",
          "enabled": true
        }
      ],
      "authentication": "none",
      "requestFormat": "custom",
      "enabled": false
    },
    {
      "name": "deepseek-vendor",
      "baseUrl": "https://api.deepseek.com",
      "models": [
        {
          "id": "deepseek-v4-flash",
          "enabled": true,
          "pricing": {
            "mode": "deepseek"
          }
        },
        {
          "id": "deepseek-v4-pro",
          "enabled": true
        }
      ],
      "authentication": "api-key",
      "apiKeyHeader": "authorization",
      "apiKey": "replace-with-deepseek-vendor-key",
      "requestFormat": "chat-completions",
      "enabled": false
    },
    {
      "name": "anthropic-vendor",
      "baseUrl": "https://api.anthropic.com/v1",
      "models": [
        {
          "id": "claude-sonnet-4.5",
          "enabled": true,
          "pricing": {
            "mode": "anthropic"
          }
        },
        {
          "id": "claude-haiku-4.5",
          "enabled": true
        }
      ],
      "authentication": "api-key",
      "apiKeyHeader": "x-api-key",
      "apiKey": "replace-with-anthropic-vendor-key",
      "requestFormat": "chat-completions",
      "enabled": false
    },
    {
      "name": "glm-vendor",
      "baseUrl": "https://open.bigmodel.cn/api/paas/v4",
      "models": [
        {
          "id": "glm-5.3",
          "enabled": true,
          "pricing": {
            "mode": "glm"
          }
        },
        {
          "id": "glm-5.3-flash",
          "enabled": true
        }
      ],
      "authentication": "api-key",
      "apiKeyHeader": "authorization",
      "apiKey": "replace-with-glm-vendor-key",
      "requestFormat": "chat-completions",
      "enabled": false
    }
  ]
}
